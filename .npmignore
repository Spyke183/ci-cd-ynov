public

# Code source (on publie uniquement le code compilé dans dist/)
src

# Tests
*.test.js

# CI / Workflows / Git
.github
.git
.gitignore

# Configs locales
.env*
.vscode
.idea
.DS_Store

# Configs JSDoc / Babel (servent au build, pas au runtime)
jsdoc.config.json
babel.config.js
.babelrc

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
